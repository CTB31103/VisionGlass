# Network
DOMAIN_NAME=<localhost>

PROD_FE_PORT=<8080>
DEV_FE_PORT=<5173>

PROD_BE_PORT=<3030>
DEV_BE_PORT=<3000>


CLOUDFLARE_VERSION=@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4
CLOUDFLARE_TOKEN=<cloudflare_api_token>
CLOURFLARE_TUNNEL_ID=<cloudflare_tunnel_id>

# Docker
COMPOSE_PROFILES=<prod, prod-app, prod-host, prod-db, prod-app-host, dev, dev-app, dev-db, db>

# Database
# 8.3.3 ubuntu slim https://hub.docker.com/layers/mongodb/mongodb-community-server/8.3.3-rc0-ubuntu2204-slim/images/sha256-857e26864b30d0ab87ca6809b3162d58b6922a63568777d0b8a615409d0a3e76
MONGO_IMAGE_VERSION=@sha256:a9898dbcb782bb9bae57660281ffcc8fc6186e674464bdaa613d9e101fc296d3 
MONGO_REPL_NAME=<rs0>
MONGO_PORT=<27017>
MONGO_DATABASE_NAME=<database_name>
MONGO_INITDB_ROOT_USERNAME=<username>
MONGO_INITDB_ROOT_PASSWORD=<password>

# Server / UI
SERVER_API_KEY=<secret_key>
JWT_SECRET_KEY=<secret_key>

# UI only
VITE_GOOGLE_CAPTCHA_SITE_KEY=<google_captcha_public_key>
VITE_GOOGLE_CAPTCHA_SECRET_KEY=<google_captcha_secret_key>